# SHELL ["/bin/bash", "-c"]
# RUN apt-get update && \
#   apt-get upgrade -y && \
#   apt-get install -y \
#   jq \
#   ncurses-bin \
#   $ADDITIONAL_APT_PACKAGES
WORKDIR ${HOME_ABSPATH}
COPY home .

RUN ls -alR ${HOME_ABSPATH}

RUN ${BOOTSTRAP_ABSPATH}/linux/update-apt.sh

RUN ${BOOTSTRAP_ABSPATH}/python/install-apt.sh

RUN ${BOOTSTRAP_ABSPATH}/linux/clean-apt.sh

