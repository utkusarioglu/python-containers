ARG BASE_IMAGE
ARG BASE_TAG
FROM utkusarioglu/${BASE_IMAGE}:${BASE_TAG}

ARG ENVIRONMENT_NAME 
ARG APT_PACKAGES
ARG APT_PACKAGES_SILENT

ARG USERNAME=dev
ARG GROUP=g
ARG GROUP_ID=1000
ARG USER_ID=1000
ARG HOME_ABSPATH=/home/${USERNAME}
ARG BOOTSTRAP_ABSPATH=${HOME_ABSPATH}/scripts/bootstrap
ARG ENVIRONMENT_REPO_RELPATH=${ENVIRONMENT_NAME}/environment.${ENVIRONMENT_NAME}.yml
ARG DEVCONTAINER_SUBFOLDER

ENV MAMBA_ROOT_PREFIX=/opt/conda

USER root

WORKDIR ${HOME_ABSPATH}
RUN ls -alR ${HOME_ABSPATH}

COPY home/scripts/ scripts/
COPY environment.common.yml environment.common.yml
COPY ${ENVIRONMENT_REPO_RELPATH} environment.repo.yml
COPY ${ENVIRONMENT_NAME}/requirements.txt requirements.txt

RUN ls -alR ${HOME_ABSPATH}

RUN ${BOOTSTRAP_ABSPATH}/linux/update-apt.sh

RUN ${BOOTSTRAP_ABSPATH}/linux/install-apt.sh "${APT_PACKAGES}"

RUN ${BOOTSTRAP_ABSPATH}/conda/install-micromamba.sh \
  ${HOME_ABSPATH} \
  ${ENVIRONMENT_NAME} \
  ${MAMBA_ROOT_PREFIX}

RUN ${BOOTSTRAP_ABSPATH}/linux/clean-apt.sh

ENV PATH ${MAMBA_ROOT_PREFIX}/envs/${ENVIRONMENT_NAME}/bin:${PATH}

USER ${USER_ID}

RUN ${BOOTSTRAP_ABSPATH}/linux/set-permissions.sh \
  ${USER_ID} \
  ${GROUP_ID} \
  ${HOME_ABSPATH}

RUN ${BOOTSTRAP_ABSPATH}/conda/install-requirements.sh ${HOME_ABSPATH}
