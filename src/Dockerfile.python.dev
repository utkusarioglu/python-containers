# RUN echo "source ${VENV_PATH}/bin/activate" >> ~/.bashrc
RUN ${BOOTSTRAP_ABSPATH}/pyhon/set-venv.sh ${VENV_PATH}

COPY src/${ENVIRONMENT_NAME}/requirements.txt \
  ${HOME_ABSPATH}/requirements.txt

RUN ${BOOTSTRAP_ABSPATH}/pyhton/install-requirements.sh \
  ${HOME_ABSPATH} \
  ${VENV_PATH}

RUN ${BOOTSTRAP_ABSPATH}/linux/set-permissions \
  ${USER_ID} \
  ${GROUP_ID} \
  ${HOME_ABSPATH}

USER ${USER_ID}
