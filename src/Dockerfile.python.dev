ARG BASE_IMAGE
ARG BASE_TAG

FROM utkusarioglu/${BASE_IMAGE}:${BASE_TAG}

ARG ENVIRONMENT_NAME 
ARG SCRIPTS_PATH
ARG USERNAME=dev
ARG USER_ID=1000
ARG GROUP=g
ARG GROUP_ID=1000
ARG ADDITIONAL_APT_PACKAGES
ARG HOME_ABSPATH=/home/$USERNAME
ARG BOOTSTRAP_ABSPATH=${HOME}/scripts/bootstrap
ARG VENV_NAME=main
ARG VENV_PATH="${HOME}/venv/${VENV_NAME}"

USER root

# RUN for arg in ROOT_PASS USERNAME GROUP ENVIRONMENT_NAME ENVIRONMENT_CONFIG; \
#   do \
#   [ ! -z "${arg}" ] || { echo "ARG \"$arg\" needs to be set"; exit 1; } \
